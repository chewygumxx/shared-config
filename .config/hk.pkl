// vim:set expandtab shiftwidth=4 filetype=pkl:
// SPDX-License-Identifier: GPL-3.0-only

//
//
// ~chewygumxx/shared-config.git
// ::: :/.config/hk.pkl
//
//

//
// https://hk.jdx.dev/configuration
//
// The git hooks, and the check and fix hooks that `mise run lint` and
// `mise run format` run. The steps come from @chewygumxx/hk-config, this
// repository's own copies of the configuration packages among their cache
// inputs. `mise install` installs the hooks; see [hooks] in
// .config/mise/config.toml.
//

amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

import "./../node_modules/@chewygumxx/hk-config/steps.pkl" as shared

local cgxx = (shared) {
    extraInputs = List("packages/**")
}

local lockfile = new Step {
    check = "bun run scripts/check-workspace-versions.mjs"
}

// Template layers are composed and checked as independent repositories.
local templates = "packages/create-repo/templates"
local templateFiles = List("\(templates)/**")

local materialized = new Step {
    check = """
        root=$PWD
        scratch=$(mktemp -d)
        trap 'rm -r -- "$scratch"' EXIT
        bun packages/create-repo/scripts/materialize.js --all "$scratch" || exit 1
        for dir in "$scratch"/*/; do
            (
                cd "$dir" &&
                    ln -s "$root/node_modules" node_modules &&
                    "$root/node_modules/.bin/biome" ci --vcs-use-ignore-file=false . &&
                    editorconfig-checker -config "$root/node_modules/@chewygumxx/editorconfig-checker-config/config.json" . &&
                    tombi format --check --offline &&
                    tombi lint --error-on-warnings --offline
            ) || exit 1
        done
        """
    cache = true
    cache_inputs = List("bun.lock", ".config/mise/config.toml", ".config/mise/tasks.toml", "packages/**")
}

local sortPackageJson = (cgxx.sort_package_json) {
    prefix = "bun run"
    check = "sort-package-json --check package.json packages/*/package.json"
    fix = "sort-package-json package.json packages/*/package.json"
}

hooks {
    ["check"] {
        steps = (cgxx.lint) {
            ["biome"] { exclude = templateFiles }
            ["packages"] {
                check = "bun run cgxx-lint-packages packages/*/"
            }
            ["sort_package_json"] = sortPackageJson
            ["templates"] = materialized
            ["lockfile"] = lockfile
        }
    }
    ["fix"] {
        stage = false
        steps = (cgxx.format) {
            ["biome"] { exclude = templateFiles }
            ["sort_package_json"] = sortPackageJson
        }
    }
    ["pre-commit"] {
        stash = "git"
        fix = false
        stage = false
        steps {
            ["check"] {
                check = """
                    HK_SKIP_STEPS="${HK_SKIP_STEPS:+$HK_SKIP_STEPS,}packages,templates" mise run lint --staged
                    """
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "mise run commit:lint \"{{ commit_msg_file }}\""
            }
        }
    }
}
