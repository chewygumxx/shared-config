// vim:set expandtab shiftwidth=4 filetype=jsonc:
// SPDX-License-Identifier: GPL-3.0-only

//
//
// ~chewygumxx/shared-config.git
// ::: :/.knip.jsonc
//
//

// https://knip.dev/reference/configuration
//
// knip finds the workspace's entry files by itself; this file lists only what
// it cannot see.

{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    "ignoreDependencies": [
        // Run by the package scripts through `xargs`, which knip does not
        // follow.
        "cspell",
        "markdownlint-cli2",
        "prettier",
        "remark-cli",
        "secretlint",
        // Extended by @chewygumxx/commitlint-config, which depends on them.
        "@commitlint/config-conventional",
        "conventional-changelog-conventionalcommits"
    ],
    // Pinned in `mise.toml` rather than installed as packages.
    "ignoreBinaries": ["actionlint", "editorconfig-checker"]
}
