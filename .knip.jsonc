// vim:set expandtab shiftwidth=4 filetype=jsonc:
// SPDX-License-Identifier: GPL-3.0-only

//
// ~chewygumxx/shared-config.git
// ::: :/.knip.jsonc
//
//

{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    "workspaces": {
        "packages/commitlint-config": {
            "entry": ["test.js"]
        },
        "packages/cz-commitlint": {
            "entry": ["test.js"]
        },
        "packages/mise-tasks-config": {
            "entry": ["test.js"]
        },
        "packages/remark-preset": {
            "entry": ["test.js"]
        },
        "packages/secretlint-rule-preset": {
            "entry": ["test.js"]
        }
    },
    "ignoreDependencies": [
        // Extended by the shared commitlint configuration.
        "@commitlint/config-conventional",
        // Read by .config/hk.pkl and .config/mise/conf.d, which Knip does not.
        "@chewygumxx/hk-config",
        "@chewygumxx/mise-tasks-config",
        // Run from hk steps, which Knip does not read.
        "@arethetypeswrong/cli",
        "@biomejs/biome",
        "commitizen",
        "cspell",
        "markdownlint-cli2",
        "prettier",
        "publint",
        "remark-cli",
        "secretlint",
        "sort-package-json",
        "sync-header-metadata"
    ],
    "ignoreBinaries": ["mise"],
    "prettier": {
        "config": [".config/prettierrc.json"]
    },
    "remark": {
        "config": [".config/remarkrc.json"]
    }
}
