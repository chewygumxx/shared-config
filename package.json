{
    "name": "shared-config",
    "private": true,
    "description": "Shared tooling configuration for chewygumxx repositories",
    "homepage": "https://github.com/chewygumxx/shared-config",
    "repository": "github:chewygumxx/shared-config",
    "license": "GPL-3.0-only",
    "author": "chewygumxx <cgumxx@pm.me> (https://github.com/chewygumxx)",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "check": "mise run check --all",
        "check:release": "HK_SKIP_STEPS=packages mise run check --all",
        "commit": "mise run commit",
        "cz": "mise run cz"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-git"
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@biomejs/biome": "2.6.9",
        "@chewygumxx/commitlint-config": "workspace:*",
        "@chewygumxx/hk-config": "workspace:*",
        "@chewygumxx/mise-tasks-config": "workspace:*",
        "@commitlint/cli": "^21.3.0",
        "@types/bun": "^1.4.5",
        "commitizen": "^4.3.2",
        "cspell": "^10.6.0",
        "cz-git": "^1.14.1",
        "knip": "^6.49.0",
        "markdownlint-cli2": "^0.24.2",
        "prettier": "^3.10.1",
        "publint": "^0.3.25",
        "release-please": "17.6.0",
        "remark-cli": "^12.0.1",
        "remark-stringify": "^11.0.0",
        "secretlint": "^14.1.0",
        "sort-package-json": "^4.1.0",
        "sync-header-metadata": "^2.4.3",
        "typescript": "^7.0.2",
        "unified": "^11.0.5"
    }
}
