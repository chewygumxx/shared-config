{
    "name": "shared-config",
    "description": "Shared tooling configuration for chewygumxx repositories",
    "private": true,
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/shared-config",
    "repository": "github:chewygumxx/shared-config",
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/cz-commitlint": "^21.2.3",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "patch-package": "^8.0.1",
        "remark-cli": "^12.0.1",
        "remark-stringify": "^11.0.0",
        "typescript": "^7.0.2",
        "unified": "^11.0.5"
    },
    "scripts": {
        "check": "npm run typecheck && npm run format:check && npm run lint && npm run lint:md",
        "commit": "cz",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:md": "git ls-files -z '*.md' | xargs -0 -r remark --frail --quiet --no-stdout",
        "postinstall": "patch-package >/dev/null",
        "prepare": "test -d node_modules/husky && husky || true",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    },
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    }
}
