#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/shared-config.git
# ::: :/packages/hk-config/bin/cgxx-lint-emdash
#
#

# Usage: cgxx-lint-emdash <file>...
#
# Fails on an em dash (U+2014) in any of the text files given.

set -eu

[ $# -gt 0 ] || exit 0

# U+2014 as UTF-8 bytes, so this file does not trip its own check.
emdash=$(printf '\342\200\224')

# grep exits 1 when it finds nothing, the only passing outcome.
status=0
grep -nIF -- "$emdash" "$@" || status=$?
case $status in
0)
    echo "Em dash (U+2014) found above; em dashes are prohibited." >&2
    exit 1
    ;;
1) exit 0 ;;
*) exit "$status" ;;
esac
