//
//
// ~chewygumxx/shared-config.git
// ::: :/packages/hk-config/steps.pkl
//
//

//
// https://hk.jdx.dev/configuration
//
// The shared hk steps. A repository's hk.pkl imports this file from
// node_modules and maps the steps it wants into its hooks; `lint` and
// `format` collect them all. hk selects the files: changed, staged, or all.
// CLIs installed with Bun run through `bun run`; the rest are mise tools.
// Upstream tests run in scratch directories. Steps that need the installed
// npm tools or shared configs omit the upstream fixtures.
//

import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

/// The published configuration packages, as Bun installs them.
hidden configs: String = "node_modules/@chewygumxx"

/// Files every step's result also depends on: the locked dependencies,
/// configuration packages included, and the pinned tools.
hidden commonInputs: List<String> = List("bun.lock", ".config/mise/config.toml")

/// Further cache inputs for every step, such as a repository's own copies
/// of the configuration packages.
hidden extraInputs: List<String> = List()

local function inputs(own: List<String>): List<String> = own + commonInputs + extraInputs

local bun = List("bun", "run")

// Replace the file placeholder with local options and/or explicit paths.
local function withFileArguments(spec: Config.CommandSpec, args: List<String>): Config.CommandSpec = (spec) {
    command = (spec.command as Config.Command) {
        argv = super.argv.flatMap((arg) -> if (arg == "{{files}}") args else List(arg))
    }
}

local function withMarkdownlintCli2(spec: Config.CommandSpec): Config.CommandSpec = (spec) {
    command = (spec.command as Config.Command) {
        argv = List("markdownlint-cli2") + super.argv.drop(1)
    }
}

local shellcheckOpts = "--rcfile=\(configs)/shellcheck-config/config.shellcheckrc"

// -------------------
// Lint: file by file
// -------------------

actionlint: Config.Step = (Builtins.actionlint) {
    check = withFileArguments(super.check as Config.CommandSpec, List(
        "-config-file", "\(configs)/actionlint-config/config.yaml", "{{files}}",
    ))
    tests = new {}
    env { ["SHELLCHECK_OPTS"] = shellcheckOpts }
    cache = true
    cache_inputs = inputs(List(".github/workflows/**"))
}

editorconfig: Config.Step = (Builtins.editorconfig_checker) {
    types = null
    glob = "**/*"
    check = withFileArguments(super.check as Config.CommandSpec, List(
        "-config", "\(configs)/editorconfig-checker-config/config.json", "{{files}}",
    ))
    fix = null
    tests = new Mapping<String, Config.StepTest> {}
    cache = true
    cache_inputs = inputs(List("**/*", ".editorconfig"))
}

emdash: Config.Step = new {
    glob = "**/*"
    check = "bun run cgxx-lint-emdash {{files}}"
    cache = true
    cache_inputs = inputs(List("**/*"))
}

remark: Config.Step = new {
    glob = "**/*.md"
    check = "bun run remark --rc-path .config/remarkrc.json --frail --quiet --no-stdout {{files}}"
    cache = true
    cache_inputs = inputs(List("**/*.md", ".config/remarkrc.json"))
}

secretlint: Config.Step = new {
    glob = "**/*"
    check = "bun run secretlint --no-gitignore {{files}}"
    cache = true
    cache_inputs = inputs(List("**/*", ".secretlintrc.json"))
}

shellcheck: Config.Step = (Builtins.shellcheck) {
    check_diff = null
    check_after_diff = false
    tests = super.tests.filter((_, test) -> test.run != "diff")
    env { ["SHELLCHECK_OPTS"] = shellcheckOpts }
    cache = true
    cache_inputs = inputs(List("**/*"))
}

cspell: Config.Step = (Builtins.cspell) {
    types = null
    glob = "**/*"
    prefix = bun
    tests = new {}
    cache = true
    cache_inputs = inputs(List("**/*", ".config/cspell.json"))
}

yamllint: Config.Step = (Builtins.yamllint) {
    env { ["YAMLLINT_CONFIG_FILE"] = "\(configs)/yamllint-config/config.yaml" }
    cache = true
    cache_inputs = inputs(List("**/*.yaml", "**/*.yml"))
}

// ---------------------------------
// Lint and format: file by file
// ---------------------------------

biome: Config.Step = (Builtins.biome) {
    glob = "**/*"
    prefix = bun
    local fileArgs = List("--no-errors-on-unmatched", "--files-ignore-unknown=true", "{{files}}")
    // Check with CI severity and leave lint fixes to an explicit Biome invocation.
    check = (super.check as Config.CommandSpec) {
        command = new Config.Command {
            argv = List("biome", "ci") + fileArgs
        }
        effect = "read"
    }
    fix = (super.fix as Config.CommandSpec) {
        command = new Config.Command {
            argv = List("biome", "format", "--write") + fileArgs
        }
    }
    tests = new {}
    cache = true
    cache_inputs = inputs(List("**/*", ".biome.json", ".biome.jsonc", "biome.json", "biome.jsonc"))
}

markdownlint: Config.Step = (Builtins.markdown_lint) {
    glob = "**/*.md"
    prefix = bun
    check = withMarkdownlintCli2(super.check as Config.CommandSpec)
    fix = withMarkdownlintCli2(super.fix as Config.CommandSpec)
    tests = new {}
    cache = true
    cache_inputs = inputs(List("**/*.md", ".markdownlint-cli2.jsonc"))
}

shfmt: Config.Step = (Builtins.shfmt) {
    match_any = Builtins.shellcheck.match_any
    tests = super.tests.filter((name, _) -> !name.contains("zsh"))
    cache = true
    cache_inputs = inputs(List("**/*", ".editorconfig"))
}

tombi: Config.Step = (Builtins.tombi_format) {
    // Keep format and strict lint under one step and avoid fetching schemas.
    check = "tombi format --check --offline -- {{files}} && tombi lint --error-on-warnings --offline -- {{files}}"
    check_diff = null
    fix = withFileArguments(super.fix as Config.CommandSpec, List("--offline", "--", "{{files}}"))
    tests = super.tests.filter((_, test) -> test.run != "diff")
    cache = true
    cache_inputs = inputs(List("**/*.toml", ".config/tombi.toml"))
}

prettier: Config.Step = (Builtins.prettier) {
    glob = List("**/*.yaml", "**/*.yml")
    prefix = bun
    local configArgs = List("--config", ".config/prettierrc.json")
    check = withFileArguments(super.check as Config.CommandSpec, configArgs + List("{{files}}"))
    check_list_files = withFileArguments(super.check_list_files as Config.CommandSpec, configArgs + List("{{files}}"))
    fix = withFileArguments(super.fix as Config.CommandSpec, configArgs + List("--log-level", "warn", "{{files}}"))
    tests = new {}
    cache = true
    cache_inputs = inputs(List("**/*.yaml", "**/*.yml", ".editorconfig", ".config/prettierrc.json"))
}

// ----------------------
// Whole project
// ----------------------

tsc: Config.Step = (Builtins.tsc) {
    glob = null
    workspace_indicator = null
    prefix = "bun run"
    check = (super.check as Config.CommandSpec) {
        command = (super.command as String).replaceAll("{{workspace_indicator}}", "tsconfig.json")
    }
    tests = new {}
    cache = true
    cache_inputs = inputs(List("**/*.js", "**/*.mjs", "**/*.ts", "**/*.mts", "**/*.d.ts", "**/tsconfig*.json", "**/package.json"))
}

knip: Config.Step = (Builtins.knip) {
    types = null
    workspace_indicator = null
    prefix = "bun run"
    check = (super.check as Config.CommandSpec) {
        command = (super.command as String).replaceAll("{{workspace}}", ".")
    }
    fix = null
    tests = new Mapping<String, Config.StepTest> {}
    cache = true
    cache_inputs = inputs(List("**/*"))
}

/// publint, and attw for packages with types. A workspace names its
/// package directories in `check`.
packages: Config.Step = new {
    check = "bun run cgxx-lint-packages ."
    cache = true
    cache_inputs = inputs(List("**/*"))
}

sort_package_json: Config.Step = (Builtins.sort_package_json) {
    glob = null
    prefix = bun
    check = withFileArguments(super.check as Config.CommandSpec, List("package.json"))
    fix = withFileArguments(super.fix as Config.CommandSpec, List("package.json"))
    exclusive = true
    cache = true
    cache_inputs = inputs(List("**/package.json"))
}

headers: Config.Step = new {
    check = "bun run sync-header-metadata"
    fix = "bun run sync-header-metadata --update"
    exclusive = true
    cache = true
    cache_inputs = inputs(List("**/*"))
}

// ------------
// Collections
// ------------

/// Every step, for the check hook.
lint: Mapping<String, Config.Step> = new {
    ["actionlint"] = actionlint
    ["biome"] = biome
    ["cspell"] = cspell
    ["editorconfig"] = editorconfig
    ["emdash"] = emdash
    ["headers"] = headers
    ["knip"] = knip
    ["markdownlint"] = markdownlint
    ["packages"] = packages
    ["prettier"] = prettier
    ["remark"] = remark
    ["secretlint"] = secretlint
    ["shellcheck"] = shellcheck
    ["shfmt"] = shfmt
    ["sort_package_json"] = sort_package_json
    ["tombi"] = tombi
    ["tsc"] = tsc
    ["yamllint"] = yamllint
}

/// The steps that fix, for the fix hook, which would otherwise run the
/// checks of the steps that cannot.
format: Mapping<String, Config.Step> = new {
    ["biome"] = biome
    ["headers"] = headers
    ["markdownlint"] = markdownlint
    ["prettier"] = prettier
    ["shfmt"] = shfmt
    ["sort_package_json"] = sort_package_json
    ["tombi"] = tombi
}
