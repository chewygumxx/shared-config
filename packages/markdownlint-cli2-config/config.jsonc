// vim:set expandtab shiftwidth=4 filetype=jsonc:
// SPDX-License-Identifier: GPL-3.0-only

//
//
// ~chewygumxx/shared-config.git
// ::: :/packages/markdownlint-cli2-config/config.jsonc
//
//

// https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
//
// The house style, as a markdownlint `config` object. Extend it from the
// `config` property of a `.markdownlint-cli2.jsonc`, or from a
// `.markdownlint.jsonc`. markdownlint merges an extended file shallowly, so a
// rule overridden locally replaces this file's options for that rule.
//
// @chewygumxx/remark-preset lints the same files. Rules are changed from the
// defaults where they disagree with it, or to pin down how these repositories
// write Markdown.

{
    "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",

    // Heading style
    "MD003": {
        "style": "atx"
    },

    // Unordered list style
    // remark-stringify writes `-` bullets.
    "MD004": {
        "style": "dash"
    },

    // Hard tabs
    // Code keeps its tabs, as Go and Makefile examples need them. Fixes
    // replace a tab in prose with four spaces.
    "MD010": {
        "code_blocks": false,
        "spaces_per_tab": 4
    },

    // Line length
    // Prose wraps at 80 columns. Code, headings and tables may exceed it, as
    // may a line whose only overflow is an unbreakable word or link.
    "MD013": {
        "line_length": 80,
        "code_blocks": false,
        "headings": false,
        "tables": false
    },

    // Headings surrounded by blank lines
    // A blank line also separates front matter from the first heading.
    "MD022": {
        "include_front_matter": true
    },

    // Multiple headings with the same content
    // Only among siblings, so a heading such as `Usage` may repeat under
    // different parents. GitHub suffixes the repeated anchors `-1`, `-2`.
    "MD024": {
        "siblings_only": true
    },

    // Multiple top-level headings in the same document, and first line in a
    // file should be a top-level heading
    // Front matter `title` is metadata; the document still opens with its own
    // `#` heading after it.
    "MD025": {
        "front_matter_title": ""
    },
    "MD041": {
        "front_matter_title": ""
    },

    // Multiple spaces after blockquote symbol
    // Not checked for a list inside a blockquote, whose intended indentation
    // markdownlint cannot reliably infer.
    "MD027": {
        "list_items": false
    }
}
