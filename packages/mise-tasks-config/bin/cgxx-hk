#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/shared-config.git
# ::: :/packages/mise-tasks-config/bin/cgxx-hk
#
#

set -euf

usage() {
    cat >&2 <<'EOF'
Usage: cgxx-hk check|fix

Runs hk's check or fix hook on changed files by default. The mise tasks set
$usage_staged for staged files, $usage_all for every file git does not ignore,
and $usage_step for the hk steps to run. A change to a path in $CGXX_WIDEN_ON
selects every file, or every file in the index with --staged. The default paths
are bun.lock, .config/hk.pkl and .config/mise. Every selected step runs even if
another step fails.
EOF
    exit 2
}

[ $# -eq 1 ] || usage
case $1 in
check | fix) hook=$1 ;;
*) usage ;;
esac

staged=${usage_staged:-false}
all=${usage_all:-false}
widen=${CGXX_WIDEN_ON-bun.lock .config/hk.pkl .config/mise}
steps=${usage_step-}

if [ "$staged" = true ] && [ "$all" = true ]; then
    echo 'cgxx-hk: --staged and --all are mutually exclusive' >&2
    exit 2
fi

# Whether a path in $widen changed among the files the flags select.
# Globbing is off, so the pathspecs reach git unexpanded.
widened() {
    [ -n "$widen" ] || return 1
    if [ "$staged" = true ]; then
        # shellcheck disable=SC2086
        if git diff --cached --quiet -- $widen; then
            return 1
        fi
    else
        # shellcheck disable=SC2086
        changes=$(git status --porcelain -- $widen)
        [ -n "$changes" ]
    fi
}

# hk's --all takes in untracked files too, which --staged must not.
from_index=false
if [ "$all" = true ]; then
    set -- --all
elif widened; then
    if [ "$staged" = true ]; then
        from_index=true
        set -- --files0-from -
    else
        set -- --all
    fi
elif [ "$staged" = true ]; then
    set -- --staged
else
    set --
fi

for step in $steps; do
    set -- "$@" --step "$step"
done

set -- "$@" --no-fail-fast
[ "$hook" = check ] || set -- "$@" --no-stage

if [ "$from_index" = true ]; then
    git ls-files -z --cached | hk "$hook" "$@"
else
    exec hk "$hook" "$@"
fi
