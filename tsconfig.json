{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "extends": "@chewygumxx/tsconfig/bun",
    "compilerOptions": {
        "allowImportingTsExtensions": true
    },
    "include": [
        ".commitlintrc.mts",
        "packages/*/*.js",
        "packages/*/*.d.ts",
        "packages/create-repo/bin/*.js",
        "packages/create-repo/lib/*.js",
        "packages/create-repo/scripts/*.js",
        "packages/create-repo/test/*.js"
    ]
}
